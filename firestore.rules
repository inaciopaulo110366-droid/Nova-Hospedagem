rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == 'dvenancio767@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(uid) {
      return isVerified() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data) {
      return data.keys().hasAll([
        'uid', 'displayName', 'email', 'role', 'status', 'sitesCount', 'storageUsedBytes', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid', 'displayName', 'email', 'role', 'status', 'sitesCount', 'storageUsedBytes', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.uid) &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
      data.role in ['user', 'admin'] &&
      data.status in ['active', 'suspended'] &&
      data.sitesCount is int && data.sitesCount >= 0 && data.sitesCount <= 1000 &&
      data.storageUsedBytes is int && data.storageUsedBytes >= 0 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidSite(data) {
      return data.keys().hasAll([
        'id', 'ownerId', 'name', 'slug', 'status', 'versionCount', 'totalSizeBytes', 'entryFile', 'sslEnabled', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'ownerId', 'name', 'slug', 'customDomain', 'status', 'currentVersionId', 'versionCount', 'totalSizeBytes', 'entryFile', 'sslEnabled', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.ownerId) &&
      data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
      data.slug is string && data.slug.size() >= 3 && data.slug.size() <= 48 &&
      data.slug.matches('^[a-z0-9]([a-z0-9\\-]{1,46}[a-z0-9])?$') &&
      (!('customDomain' in data) || (data.customDomain is string && data.customDomain.size() <= 120)) &&
      data.status in ['online', 'suspended', 'blocked'] &&
      (!('currentVersionId' in data) || (data.currentVersionId is string && data.currentVersionId.size() <= 128)) &&
      data.versionCount is int && data.versionCount >= 0 && data.versionCount <= 10000 &&
      data.totalSizeBytes is int && data.totalSizeBytes >= 0 &&
      data.entryFile is string && data.entryFile.size() >= 1 && data.entryFile.size() <= 120 &&
      data.sslEnabled is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidDeployment(data) {
      return data.keys().hasAll([
        'id', 'siteId', 'ownerId', 'versionNumber', 'status', 'sourceType', 'sizeBytes', 'fileCount', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'siteId', 'ownerId', 'versionNumber', 'status', 'sourceType', 'sizeBytes', 'fileCount', 'notes', 'createdAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.siteId) &&
      isValidId(data.ownerId) &&
      data.versionNumber is int && data.versionNumber >= 1 && data.versionNumber <= 10000 &&
      data.status in ['published', 'archived', 'removed'] &&
      data.sourceType in ['zip', 'html', 'editor', 'files'] &&
      data.sizeBytes is int && data.sizeBytes >= 0 &&
      data.fileCount is int && data.fileCount >= 0 && data.fileCount <= 5000 &&
      (!('notes' in data) || (data.notes is string && data.notes.size() <= 240)) &&
      data.createdAt is timestamp;
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['id', 'title', 'message', 'severity', 'active', 'createdAt']) &&
      data.keys().hasOnly(['id', 'title', 'message', 'severity', 'active', 'createdAt']) &&
      isValidId(data.id) &&
      data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
      data.message is string && data.message.size() >= 2 && data.message.size() <= 600 &&
      data.severity in ['info', 'warning', 'maintenance'] &&
      data.active is bool &&
      data.createdAt is timestamp;
    }

    function isValidPlatformSettings(data) {
      return data.keys().hasAll(['maxSitesPerUser', 'maxSiteSizeMb', 'allowSignups', 'maintenanceMode', 'updatedAt']) &&
      data.keys().hasOnly(['maxSitesPerUser', 'maxSiteSizeMb', 'allowSignups', 'maintenanceMode', 'updatedAt']) &&
      data.maxSitesPerUser is int && data.maxSitesPerUser >= 1 && data.maxSitesPerUser <= 100 &&
      data.maxSiteSizeMb is int && data.maxSiteSizeMb >= 1 && data.maxSiteSizeMb <= 2048 &&
      data.allowSignups is bool &&
      data.maintenanceMode is bool &&
      data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
      data.keys().hasOnly(['uid', 'email', 'createdAt']) &&
      isValidId(data.uid) &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
      data.createdAt is timestamp;
    }

    // --- Collection Rules ---
    match /users/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(uid) &&
        isOwner(uid) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == uid &&
        incoming().email == request.auth.token.email &&
        incoming().role == (isBootstrappedAdmin() ? 'admin' : 'user') &&
        incoming().status == 'active' &&
        incoming().sitesCount == 0 &&
        incoming().storageUsedBytes == 0 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(uid) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            isOwner(uid) &&
            existing().status == 'active' &&
            incoming().role == existing().role &&
            incoming().status == existing().status &&
            incoming().email == existing().email &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'sitesCount', 'storageUsedBytes', 'updatedAt'])
          )
        );
      allow delete: if isValidId(uid) && isAdmin();
    }

    match /sites/{siteId} {
      allow get: if isValidId(siteId) && ((resource != null && isOwner(existing().ownerId)) || isAdmin());
      allow list: if isVerified() && (resource.data.ownerId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isValidId(siteId) &&
        isVerified() &&
        isValidSite(incoming()) &&
        incoming().id == siteId &&
        incoming().ownerId == request.auth.uid &&
        incoming().status == 'online' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(siteId) &&
        isValidSite(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            isOwner(existing().ownerId) &&
            existing().status != 'blocked' &&
            incoming().status in ['online', 'suspended'] &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'slug', 'customDomain', 'status', 'currentVersionId', 'versionCount', 'totalSizeBytes', 'entryFile', 'sslEnabled', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(siteId) && ((resource != null && isOwner(existing().ownerId)) || isAdmin());

      match /deployments/{deploymentId} {
        allow get: if isValidId(siteId) && isValidId(deploymentId) && (
          isOwner(get(/databases/$(database)/documents/sites/$(siteId)).data.ownerId) || isAdmin()
        );
        allow list: if isValidId(siteId) && isVerified() && (
          resource.data.ownerId == request.auth.uid || isBootstrappedAdmin()
        );
        allow create: if isValidId(siteId) && isValidId(deploymentId) &&
          isVerified() &&
          isValidDeployment(incoming()) &&
          incoming().id == deploymentId &&
          incoming().siteId == siteId &&
          incoming().ownerId == request.auth.uid &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/sites/$(siteId)) &&
          get(/databases/$(database)/documents/sites/$(siteId)).data.ownerId == request.auth.uid &&
          get(/databases/$(database)/documents/sites/$(siteId)).data.status != 'blocked';
        allow update: if isValidId(siteId) && isValidId(deploymentId) &&
          isValidDeployment(incoming()) &&
          incoming().id == existing().id &&
          incoming().siteId == existing().siteId &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt && (
            isAdmin() || (
              isOwner(existing().ownerId) &&
              existing().status != 'removed' &&
              incoming().status in ['published', 'archived'] &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes'])
            )
          );
        allow delete: if isValidId(siteId) && isValidId(deploymentId) && (
          (resource != null && isOwner(existing().ownerId)) || isAdmin()
        );
      }
    }

    match /announcements/{announcementId} {
      allow get: if isValidId(announcementId);
      allow list: if resource.data.active == true || isBootstrappedAdmin();
      allow create: if isValidId(announcementId) && isAdmin() && isValidAnnouncement(incoming()) && incoming().id == announcementId && incoming().createdAt == request.time;
      allow update: if isValidId(announcementId) && isAdmin() && isValidAnnouncement(incoming()) && incoming().id == existing().id && incoming().createdAt == existing().createdAt && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'message', 'severity', 'active']);
      allow delete: if isValidId(announcementId) && isAdmin();
    }

    match /platformSettings/{settingId} {
      allow get: if isValidId(settingId) && (isSignedIn() || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(settingId) && isAdmin() && isValidPlatformSettings(incoming()) && incoming().updatedAt == request.time;
      allow update: if isValidId(settingId) && isAdmin() && isValidPlatformSettings(incoming()) && incoming().updatedAt == request.time && incoming().diff(existing()).affectedKeys().hasOnly(['maxSitesPerUser', 'maxSiteSizeMb', 'allowSignups', 'maintenanceMode', 'updatedAt']);
      allow delete: if false;
    }

    match /admins/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(uid) && isBootstrappedAdmin() && isValidAdminRecord(incoming()) && incoming().createdAt == request.time;
      allow update: if isValidId(uid) && isBootstrappedAdmin() && isValidAdminRecord(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(uid) && isBootstrappedAdmin();
    }
  }
}
