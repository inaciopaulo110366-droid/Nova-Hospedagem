# GEMINI_API_KEY: Optional for AI features.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Automatically injected at runtime by the hosting environment.
APP_URL="MY_APP_URL"

# PRIMARY_DOMAIN: Main domain controlled by the platform.
PRIMARY_DOMAIN="nh.com.br"

# FORCE_HTTPS: Redirect HTTP traffic to HTTPS behind proxy/CDN (true/false).
FORCE_HTTPS="false"

# Optional Cloudflare R2 / S3-compatible external object storage configuration
R2_ENDPOINT=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
